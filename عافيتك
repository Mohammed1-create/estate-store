<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>صيدليتي الإلكترونية</title>

<link rel="stylesheet" href="style.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>

<!-- HEADER -->

<header class="header">

    <div class="logo">
        <i class="fa-solid fa-capsules"></i>
        صيدليتي
    </div>

    <div class="search-box">
        <input type="text" placeholder="ابحث عن دواء أو منتج...">
        <button>
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </div>

    <div class="header-icons">

        <div class="cart">
            <i class="fa-solid fa-cart-shopping"></i>
            <span id="cart-count">0</span>
        </div>

        <div class="profile">
            <i class="fa-solid fa-user"></i>
        </div>

    </div>

</header>

<!-- HERO -->

<section class="hero">

    <div class="hero-content">

        <h1>كل ما تحتاجه لصحتك في مكان واحد</h1>

        <p>
            اطلب أدويتك ومنتجات العناية الصحية بسهولة وأمان.
        </p>

        <div class="hero-buttons">
            <button class="primary-btn">
                تصفح المنتجات
            </button>

            <button class="secondary-btn">
                ارفع وصفتك الطبية
            </button>
        </div>

    </div>

</section>

<!-- CATEGORIES -->

<section class="categories">

    <h2>الأقسام</h2>

    <div class="category-grid">

        <div class="category-card">
            <i class="fa-solid fa-pills"></i>
            <span>الأدوية</span>
        </div>

        <div class="category-card">
            <i class="fa-solid fa-heart-pulse"></i>
            <span>المكملات الغذائية</span>
        </div>

        <div class="category-card">
            <i class="fa-solid fa-spa"></i>
            <span>العناية بالبشرة</span>
        </div>

        <div class="category-card">
            <i class="fa-solid fa-baby"></i>
            <span>الأطفال</span>
        </div>

    </div>

</section>

<!-- PRODUCTS -->

<section class="products">

    <h2>المنتجات الأكثر طلباً</h2>

    <div class="product-grid">

        <div class="product-card">

            <img src="https://via.placeholder.com/250"
                 alt="product">

            <h3>فيتامين C</h3>

            <p class="price">15$</p>

            <button class="add-to-cart">
                أضف إلى السلة
            </button>

        </div>

        <div class="product-card">

            <img src="https://via.placeholder.com/250"
                 alt="product">

            <h3>كريم عناية بالبشرة</h3>

            <p class="price">20$</p>

            <button class="add-to-cart">
                أضف إلى السلة
            </button>

        </div>

        <div class="product-card">

            <img src="https://via.placeholder.com/250"
                 alt="product">

            <h3>مكمل غذائي</h3>

            <p class="price">30$</p>

            <button class="add-to-cart">
                أضف إلى السلة
            </button>

        </div>

    </div>

</section>

<script src="script.js"></script>

</body>
</html>
